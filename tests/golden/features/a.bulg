// Two modules each with a private `hh` (renamed in the text), structs, arrays, half,
// unsigned arithmetic, out parameters, swizzle writes and a uniform array.
struct Hit { float d; vec3 n; };
const float W[3] = float[3](.25, .5, .25);
uniform vec4 uSite[4];
uniform sampler2D uPrev;
float hh(float x) { return x * 2.; }
uint hash(uint x) { x ^= x >> 16u; x *= 0x7feb352du; return x ^ x >> 15u; }
bool hit(vec3 p, out Hit h) {
    h = Hit(length(p) - 1., normalize(p));
    h.n.zx = h.n.xz;
    return h.d < 0.;
}
half soft(half x) { return x * half(.5); }
float blur(vec2 uv) {
    float s = 0.;
    for (int i = 0; i < W.length(); i++) s += W[i] * texture(uPrev, uv + vec2(float(i - 1), 0.) / 512.).r;
    return hh(s);
}
